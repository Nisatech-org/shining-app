<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only: the same as main's network_security_config.xml (Samad's Certum root), plus
    plain HTTP to a Shining server on this computer, for testing the server and the market on an
    emulator (10.0.2.2 is the computer as the emulator sees it) or over `adb reverse` (localhost):
        ./gradlew assembleDebug -PshiningServerUrl=http://10.0.2.2:8050/
    Release builds use main's file and never allow plain HTTP.
-->
<network-security-config>
    <domain-config>
        <domain includeSubdomains="false">setad.dining.sharif.edu</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/certum_trusted_root_ca" />
        </trust-anchors>
    </domain-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
